# ============ 抽取模型（Extractor）============
# 默认用 DeepSeek（便宜）：https://platform.deepseek.com
EXTRACTOR_BASE_URL=https://api.deepseek.com
EXTRACTOR_API_KEY=sk-xxxxxxxxxxxxxxxx
EXTRACTOR_MODEL=deepseek-flash

# ============ 审核模型（CriticMaster）============
# 题目要求「用另一个模型挑刺」。三选一：
#   A. 阿里通义千问（DashScope，有免费额度）
#      CRITIC_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#      CRITIC_MODEL=qwen-plus
#   B. 智谱 GLM
#      CRITIC_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#      CRITIC_MODEL=glm-4-flash
#   C. 没有第二家 key 时，退化用 DeepSeek 的另一个模型
#      CRITIC_BASE_URL=https://api.deepseek.com
#      CRITIC_MODEL=deepseek-v4-pro
CRITIC_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CRITIC_API_KEY=sk-xxxxxxxxxxxxxxxx
CRITIC_MODEL=qwen-plus

# ============ 对抗循环参数 ============
MAX_ROUNDS=3           # 最多修订轮数
PASS_SCORE=8           # 达标分数（1-10）
ACCURACY_TOLERANCE=0.05  # 字段级容差 ±5%
